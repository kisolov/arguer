ENVIRONMENT=production

BOT_TOKEN=<telegram bot token from @BotFather>

DB_HOST=mysql
DB_DATABASE=arguer_db
DB_USER=arguer
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
DB_PORT=3306
DB_PROVIDER=mysql

REDIS_HOST=redis
REDIS_PORT=6379

GENAPI_BASE_URL=https://api.gen-api.ru/api/v1
GENAPI_API_KEY=<gen-api key>
GENAPI_DEFAULT_TIMEOUT_SECONDS=240
GENAPI_MODEL=gpt-4o-mini
# Повторы при ошибке соединения, 429 и 5xx; таймаут чтения не повторяется
GENAPI_MAX_RETRIES=2
GENAPI_RETRY_BACKOFF_SECONDS=1

YC_CLI_PATH=yc
YC_KEY_ID=<static access key id>
YC_STATIC_KEY=<static access key secret>
YC_FOLDER_ID=<folder id>
YC_BUCKET_NAME=<bucket for voice files>
YC_BUCKET_ENDPOINT_URL=https://storage.yandexcloud.net
YC_SERVICE_ACCOUNT_KEY_FILE=./yc_config.yaml
YC_STT_API_URL=https://transcribe.api.cloud.yandex.net/speech/stt/v2/longRunningRecognize
YC_OPERATION_API_URL=https://operation.api.cloud.yandex.net/operations/

YOO_SHOP_ID=<yookassa shop id>
YOO_SECRET_KEY=<yookassa secret key>
YOO_RETURN_URL=https://t.me/<your_bot>

APP_UNPROCESSED_MESSAGES_LIMIT=30
APP_UNPROCESSED_MEDIA_DURATION_LIMIT=120
# Предел текста всего спора (прошлые раунды + новые сообщения): вся история уходит в модель
APP_CONTEXT_SYMBOLS_LIMIT=60000
# Включает имитацию пересланных сообщений вида `текст (id)` для ручной отладки. В проде держать false.
APP_ENABLE_TEST_MESSAGES=false
